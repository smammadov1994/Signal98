# Copy to .env.local (gitignored). Everything is optional: without any of it the stack
# still runs, with a labelled heuristic instead of JEV and dry-run notifications.

# --- JEV (the classifier) — https://console.typesafe.ai
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest            # pin e.g. jev-1.13.0 once thresholds are tuned
# JEV_MAX_RPM=600                 # stay under your account's requests/minute
# JEV_MAX_CONCURRENT=6

# --- Email alerts: either one
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SIGNAL98_EMAIL_FROM="signal98 <alerts@yourdomain.com>"
# SIGNAL98_ALERT_EMAIL=you@example.com     # default recipient, used when the database is first created

# --- Links inside alerts point here
# SIGNAL98_PUBLIC_URL=http://localhost:3001

# --- Lock the monitor + admin API (ingest stays public, as it must)
# SIGNAL98_ADMIN_TOKEN=

# --- First project's ingest key (default: s98_pk_local_dev — change before exposing to a network)
# SIGNAL98_DEFAULT_KEY=

# --- The ghost. Default provider: the Claude Code CLI if it is installed (uses your login).
# SIGNAL98_CLAUDE_BIN=/path/to/claude
# SIGNAL98_GHOST_MODEL=sonnet
# SIGNAL98_AGENT_BUDGET_USD=2
# SIGNAL98_GHOST_PROVIDER=none             # disable the CLI provider
# Any OpenAI-compatible endpoint works as the fallback writer of fix reports:
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# --- Storage
# SIGNAL98_DATA_DIR=./data
